{
  "name": "dtc-mcp",
  "version": "1.0.0-rc.1",
  "description": "Stainless-style two-tool MCP server for DTC e-commerce. Replaces 22 hand-built tools with execute_code + search_docs — LLM writes TypeScript against typed Klaviyo + Shopify SDKs in an isolated V8 sandbox.",
  "type": "module",
  "bin": {
    "dtc-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector dist/index.js",
    "codegen:klaviyo": "tsx tools/codegen/klaviyo.ts",
    "codegen:shopify": "tsx tools/codegen/shopify.ts",
    "codegen:docs": "tsx tools/codegen/docs.ts",
    "codegen": "npm run codegen:klaviyo && npm run codegen:shopify && npm run codegen:docs"
  },
  "keywords": [
    "mcp",
    "klaviyo",
    "shopify",
    "dtc",
    "ecommerce",
    "code-execution",
    "sandbox",
    "stainless",
    "code-mode"
  ],
  "author": "Rafael Sztutman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelsztutman/dtc-mcp.git"
  },
  "homepage": "https://github.com/rafaelsztutman/dtc-mcp#readme",
  "bugs": {
    "url": "https://github.com/rafaelsztutman/dtc-mcp/issues"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "dotenv": "^17.3.1",
    "isolated-vm": "^6.1.2",
    "minisearch": "^7.1.0",
    "sucrase": "^3.35.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
